{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:public",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/cad/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://3dviewer.net" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/s/:code",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "https://machmo.tail3b04e8.ts.net:10000/health" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/s/:code", "destination": "/index.html" },
    { "source": "/:section(app|learn|build|tools|community|auth)/:path*", "destination": "/index.html" },
    { "source": "/:page(boards|components|topics|projects|feedback|privacy|login)", "destination": "/index.html" }
  ]
}
