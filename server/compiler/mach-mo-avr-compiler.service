[Unit]
Description=Mạch Mở Arduino AVR compiler

[Service]
Type=simple
EnvironmentFile=%h/.local/share/mach-mo/avr-compiler/current/image.env
ExecStart=/usr/bin/node %h/.local/share/mach-mo/avr-compiler/current/service.mjs
Delegate=yes
MemoryMax=768M
TasksMax=160
UMask=0077
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
