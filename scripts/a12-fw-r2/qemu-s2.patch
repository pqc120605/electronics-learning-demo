diff --git a/hw/gpio/esp32s2_gpio.c b/hw/gpio/esp32s2_gpio.c
index 840f8f3..e4b9b16 100644
--- a/hw/gpio/esp32s2_gpio.c
+++ b/hw/gpio/esp32s2_gpio.c
@@ -18,14 +18,106 @@
 #include "hw/irq.h"
 #include "hw/qdev-properties.h"
 #include "hw/gpio/esp32s2_gpio.h"
+#include "qapi/visitor.h"
+#include "sysemu/runstate.h"
 
+enum {
+    GPIO_OUT = 0x04, GPIO_OUT_SET = 0x08, GPIO_OUT_CLEAR = 0x0c,
+    GPIO_ENABLE = 0x20, GPIO_ENABLE_SET = 0x24, GPIO_ENABLE_CLEAR = 0x28,
+    GPIO_IN = 0x3c, GPIO5_FUNC = 0x568,
+    MUX_GPIO4 = 0x14, MUX_GPIO5 = 0x18,
+    MUX_FUNC_SHIFT = 12, MUX_INPUT_EN = 1 << 9,
+    GPIO4 = 1 << 4, GPIO5 = 1 << 5, GPIO_MASK = GPIO4 | GPIO5,
+};
+
+static bool mux_gpio(uint32_t mux)
+{
+    return ((mux >> MUX_FUNC_SHIFT) & 7) == 1;
+}
+
+static bool gpio5_driven(Object *obj, Error **errp)
+{
+    Esp32s2GpioState *s = ESP32_GPIO(obj);
+    return (s->enable & GPIO5) && mux_gpio(s->mux[1])
+        && (s->gpio5_func & 0x1ff) == 256
+        && !(s->gpio5_func & ((1 << 9) | (1 << 11)));
+}
+
+static bool gpio5_high(Object *obj, Error **errp)
+{
+    return gpio5_driven(obj, errp) && (ESP32_GPIO(obj)->out & GPIO5);
+}
+
+static bool gpio4_input(Object *obj, Error **errp)
+{
+    Esp32s2GpioState *s = ESP32_GPIO(obj);
+    return !(s->enable & GPIO4) && mux_gpio(s->mux[0])
+        && (s->mux[0] & MUX_INPUT_EN) && s->gpio4_high;
+}
+
+static bool gpio4_level(Object *obj, Error **errp)
+{
+    return ESP32_GPIO(obj)->gpio4_high;
+}
+
+static void gpio4_stimulus(Object *obj, bool high, Error **errp)
+{
+    ESP32_GPIO(obj)->gpio4_high = high;
+}
+
+static void record_output(Esp32s2GpioState *s, bool before)
+{
+    if (before != gpio5_high(OBJECT(s), NULL)) {
+        s->a12_edge_us = qemu_clock_get_us(QEMU_CLOCK_VIRTUAL);
+        s->a12_edges++;
+    }
+}
+
+static void a12_pause(void *opaque)
+{
+    qemu_system_vmstop_request_prepare();
+    qemu_system_vmstop_request(RUN_STATE_PAUSED);
+}
 
+static void a12_set_window(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    int64_t window;
+
+    if (!visit_type_int64(v, name, &window, errp)) {
+        return;
+    }
+    if (runstate_is_running() || window < 1000 || window > 100000) {
+        error_setg(errp, "A12 window requires a paused machine and 1..100 ms");
+        return;
+    }
+    timer_mod_ns(ESP32_GPIO(obj)->a12_stop,
+                 qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + window * 1000);
+}
+
+static void a12_read_counter(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    int64_t value = *(int64_t *)opaque;
+    visit_type_int64(v, name, &value, errp);
+}
+
+static void a12_read_clock(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    int64_t value = qemu_clock_get_us(QEMU_CLOCK_VIRTUAL);
+    visit_type_int64(v, name, &value, errp);
+}
 
 static uint64_t esp32s2_gpio_read(void *opaque, hwaddr addr, unsigned int size)
 {
     Esp32s2GpioState *s = ESP32_GPIO(opaque);
     uint64_t r = 0;
     switch (addr) {
+    case GPIO_OUT: return s->out;
+    case GPIO_ENABLE: return s->enable;
+    case GPIO_IN: return gpio4_input(OBJECT(s), NULL) ? GPIO4 : 0;
+    case GPIO5_FUNC: return s->gpio5_func;
     case A_GPIO_STRAP:
         r = s->strap_mode;
         break;
@@ -39,8 +131,53 @@ static uint64_t esp32s2_gpio_read(void *opaque, hwaddr addr, unsigned int size)
 static void esp32s2_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
+    Esp32s2GpioState *s = ESP32_GPIO(opaque);
+    bool before = gpio5_high(OBJECT(s), NULL);
+    uint32_t pins = value & GPIO_MASK;
+
+    switch (addr) {
+    case GPIO_OUT: s->out = pins; break;
+    case GPIO_OUT_SET: s->out |= pins; break;
+    case GPIO_OUT_CLEAR: s->out &= ~pins; break;
+    case GPIO_ENABLE: s->enable = pins; break;
+    case GPIO_ENABLE_SET: s->enable |= pins; break;
+    case GPIO_ENABLE_CLEAR: s->enable &= ~pins; break;
+    case GPIO5_FUNC: s->gpio5_func = value; break;
+    default: return;
+    }
+    record_output(s, before);
 }
 
+static uint64_t a12_mux_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32s2GpioState *s = ESP32_GPIO(opaque);
+    switch (addr) {
+    case MUX_GPIO4: return s->mux[0];
+    case MUX_GPIO5: return s->mux[1];
+    default: return 0;
+    }
+}
+
+static void a12_mux_write(void *opaque, hwaddr addr, uint64_t value,
+                          unsigned int size)
+{
+    Esp32s2GpioState *s = ESP32_GPIO(opaque);
+    bool before = gpio5_high(OBJECT(s), NULL);
+
+    switch (addr) {
+    case MUX_GPIO4: s->mux[0] = value; break;
+    case MUX_GPIO5: s->mux[1] = value; break;
+    default: return;
+    }
+    record_output(s, before);
+}
+
+static const MemoryRegionOps iomux_ops = {
+    .read = a12_mux_read,
+    .write = a12_mux_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
 static const MemoryRegionOps uart_ops = {
     .read =  esp32s2_gpio_read,
     .write = esp32s2_gpio_write,
@@ -49,6 +186,20 @@ static const MemoryRegionOps uart_ops = {
 
 static void esp32s2_gpio_reset(DeviceState *dev)
 {
+    Esp32s2GpioState *s = ESP32_GPIO(dev);
+    s->out = 0;
+    s->enable = 0;
+    s->gpio5_func = 0;
+    s->mux[0] = s->mux[1] = 0;
+    s->gpio4_high = true;
+    s->a12_edge_us = 0;
+    s->a12_edges = 0;
+    timer_del(s->a12_stop);
+}
+
+static void esp32s2_gpio_finalize(Object *obj)
+{
+    timer_free(ESP32_GPIO(obj)->a12_stop);
 }
 
 static void esp32s2_gpio_realize(DeviceState *dev, Error **errp)
@@ -64,6 +215,17 @@ static void esp32s2_gpio_init(Object *obj)
                           TYPE_ESP32S2_GPIO, 0x1000);
     sysbus_init_mmio(sbd, &s->iomem);
     sysbus_init_irq(sbd, &s->irq);
+
+    memory_region_init_io(&s->iomux, obj, &iomux_ops, s, "esp32s2.iomux", 0x2000);
+    s->a12_stop = timer_new_ns(QEMU_CLOCK_VIRTUAL, a12_pause, s);
+    object_property_add_bool(obj, "a12-stimulus-high", gpio4_level, gpio4_stimulus);
+    object_property_add_bool(obj, "a12-input-high", gpio4_input, NULL);
+    object_property_add_bool(obj, "a12-output-driven", gpio5_driven, NULL);
+    object_property_add_bool(obj, "a12-output-high", gpio5_high, NULL);
+    object_property_add(obj, "a12-edge-us", "int", a12_read_counter, NULL, NULL, &s->a12_edge_us);
+    object_property_add(obj, "a12-edges", "int", a12_read_counter, NULL, NULL, &s->a12_edges);
+    object_property_add(obj, "a12-clock-us", "int", a12_read_clock, NULL, NULL, NULL);
+    object_property_add(obj, "a12-window-us", "int", NULL, a12_set_window, NULL, NULL);
 }
 
