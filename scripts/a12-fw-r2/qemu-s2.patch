@@ -85,6 +247,7 @@ static const TypeInfo esp32s2_gpio_info = {
     .parent = TYPE_SYS_BUS_DEVICE,
     .instance_size = sizeof(Esp32s2GpioState),
     .instance_init = esp32s2_gpio_init,
