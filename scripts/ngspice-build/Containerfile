FROM docker.io/emscripten/emsdk@sha256:90b757eb11fa9a0e3ce4d2d9f76d932a56018e4accc37b5a28b2783751e60eb7
RUN apt-get update && apt-get install -y --no-install-recommends autoconf automake libtool bison && rm -rf /var/lib/apt/lists/*
COPY build.sh /opt/machmo/build.sh
COPY sources.json /opt/machmo/sources.json
ENTRYPOINT ["bash", "/opt/machmo/build.sh"]
