  "outputs": {
    "boards": "9 mặt trên 2D và 9 GLB 3D tương tác. Tên chân và linh kiện hiển thị theo đúng phiên bản nguồn.",
    "components": "4 bộ gồm sơ đồ chân, mặt 2D, GLB tương tác và footprint KiCad tải được.",
    "notes": "Nguồn, giấy phép, biến thể, độ khớp hình học và các tọa độ chưa đối chiếu xuất hiện trong hồ sơ mẫu."
  },
  "implementationLimits": [
    "Mô hình phục vụ tra cứu và kiểm thử trên localhost.",
    "Giữ catalogId và libraryPinId hiện có để bảo toàn dây nối và bản nháp.",
    "Tên chân từ tài liệu và vị trí pin trong hình học phải khớp riêng. Vị trí chưa khớp dùng tra cứu tên theo nguồn.",
    "Mặt 2D bắt nguồn từ đúng GLB. Tọa độ được đối chiếu với PCB và footprint nguồn theo đơn vị mm, chuyển sang mét ở trình xem.",
    "Dữ liệu mô phỏng hiện có giữ nguyên. Hình học và footprint mang trạng thái tham chiếu.",
    "Xác minh quyền phân phối và phạm vi giấy phép của tài liệu hãng trước một đợt phát hành công khai."
  ],
