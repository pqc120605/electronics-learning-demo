    "profile": {
      "packages": "CPU.CortexM và IRQControllers.NVIC 0xE000E000 với priorityMask 0xF0, SysTick và UART clock bằng clock đã chốt của từng board. Đọc thanh ghi GPIO trực tiếp và đếm tick từ biến firmware. Baud nominal đặt qua BRR, tiêu chí UART là chuỗi byte UART backend.",
      "clocks": "Clock được cố định ở giá trị đã duyệt. Vùng RCC fixture 0x40021000 kích thước 0x400 chỉ nhận/đọc lại bit enable cần cho chương trình, clock-gating và PLL nằm ngoài mô hình.",
      "scope": "Mỗi board cần Renode boot đúng ELF, quan sát PA10 do mạch điều khiển và PB5 thực thi từ firmware. L4 dùng model lớp USART chung theo thanh ghi tương thích, phải chứng minh bằng I/O backend; nếu bất kỳ class hay hành vi nào không đạt thì giữ target ở trạng thái chưa hỗ trợ và báo kết quả."
    },
    "transport": {
      "route": "/api/local-tools/a9-stm32/",
      "runnerArguments": [
        "--disable-gui",
        "--console",
        "--plain",
        "--port",
        "-1"
